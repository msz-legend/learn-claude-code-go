# Copy this file to .env and fill in one provider.
#
# The harness supports two protocols:
#   anthropic - Anthropic Messages API, or any compatible gateway
#   openai    - OpenAI-compatible chat completions (DeepSeek, GLM, Qwen, Ollama, ...)

# --- Protocol and model ---------------------------------------------------
LLM_PROTOCOL=anthropic
MODEL_ID=claude-sonnet-4-5

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI-compatible ----------------------------------------------------
# LLM_PROTOCOL=openai
# MODEL_ID=deepseek-chat
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# Local Ollama example:
# LLM_PROTOCOL=openai
# MODEL_ID=qwen2.5-coder:7b
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1

# --- Runtime knobs --------------------------------------------------------
# MAX_TOKENS=8000
# LLM_TIMEOUT_SECONDS=180

# --- Harness chapters -----------------------------------------------------
# PERMISSION_MODE=ask
# SKILLS_DIR=skills
# SUBAGENT_MAX_TURNS=12
# TEAMMATE_MAX_TURNS=30
# COMPACT_TOOL_RESULT_BUDGET=200000
# COMPACT_SUMMARIZE_AT_TOKENS=24000
# COMPACT_KEEP_MESSAGES=8
# WORKFLOW_AGENT_TURNS=10
# GOAL_MAX_TURNS=12
# GOAL=
