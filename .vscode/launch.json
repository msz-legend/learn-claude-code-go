{
    // One launch target per chapter, plus the s14 demo MCP server and the
    // offline harness tests.
    //
    // Chapters are stdin REPLs and read ANTHROPIC_API_KEY / OPENAI_API_KEY and
    // friends from .env (see .env.example). Copy .env.example to .env first,
    // then press F5. "integratedTerminal" is what makes stdin work while
    // debugging; the default debug console is read-only.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "s01: Agent Loop",
            "type": "go",
            "request": "launch",
            "program": "${workspaceFolder}/s01_agent_loop",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "s02: Tool Use",
            "type": "go",
            "request": "launch",
            "program": "${workspaceFolder}/s02_tool_use",
            "cwd": "${workspaceFolder}",
